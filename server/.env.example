# ============ 运行配置 ============
# 监听端口。orkestr 会自动注入 PORT，本地默认 8080
PORT=8080

# 数据库驱动：
#   pg     = PostgreSQL（生产环境用这个）
#   memory = 内存（本地开发用，进程重启数据全丢，切勿用于生产）
DB_DRIVER=memory

# PostgreSQL 连接串。在 orkestr 上添加 PostgreSQL 附加组件后会自动注入，无需手填
DATABASE_URL=

# ============ 密钥（必须自己生成，不要用示例值） ============

# 管理接口令牌。生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# 票据签名私钥（PKCS#8 PEM）。由 `npm run gen-keys` 生成。
# 环境变量里换行用字面量 \n 表示，服务启动时会自动还原为真实换行。
# ⚠️ 私钥泄露 = 授权系统彻底失效，务必只放在服务端环境变量里，绝不进 Git
TICKET_PRIVATE_KEY_PEM=

# ============ 可选 ============
# 对外访问地址，仅用于日志与文档展示
PUBLIC_BASE_URL=http://localhost:8080

# 是否在启动时自动执行建表 SQL（首次部署建议 true，之后可关）
AUTO_MIGRATE=true

# 公共接口限流：每 IP 每窗口允许的请求数 / 窗口秒数
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_SEC=60
