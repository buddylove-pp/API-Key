    "test": "node test/checkplan.mjs && node test/dbhealth.mjs && node test/e2e.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
